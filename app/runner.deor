# One run of one job: record it, run the command, write the log, record how it ended.

fn Run run_record(Job target_job, string trigger_kind, string status)
	(job_id, name) in target_job

	int run_id = 0
	string job_name = name
	int started_at = n_now()
	int finished_at = 0
	int exit_code = -1
	string note = ""
	Run record = (run_id, job_id, job_name, started_at, finished_at, status, exit_code, trigger_kind, note)

	return record

# A run that never started because the computer was asleep or the job was still running.
fn void record_skip(Database store, Job target_job, string note)
	string trigger_kind = "schedule"
	string status = "skipped"
	Run base = run_record(target_job, trigger_kind, status)
	int finished_at = n_now()
	Run skipped = base with (finished_at, note)
	int skipped_id = db_insert_run(store, skipped)

	if skipped_id is 0
		print("job runner: could not record a skipped run")

# Turns the command's exit code into the finished record, with a plain-English reason when it failed.
fn Run finished_run(Run started, int exit_code)
	const int SIGNAL_KILLED = -1
	const int NOT_STARTED = -2

	string status = "failed"
	string note = ""

	if exit_code is 0
		status = "ok"
	else if exit_code is SIGNAL_KILLED
		note = "Failed: the command was stopped by a signal"
	else if exit_code is NOT_STARTED
		note = "Failed: the command could not be started (check the folder)"
	else
		string code_text = c_int_to_string(exit_code)
		note = s_join(["Failed: the command exited with code ", code_text])

	int finished_at = n_now()
	Run finished = started with (status, note, exit_code, finished_at)

	return finished

# A log line that cannot be written is reported, since a missing log hides why a run failed.
fn void append_log(string log_path, string text)
	rust
		use std::io::Write;

		report_io(std::fs::OpenOptions::new().append(true).create(true).open(&log_path).and_then(|mut log_file| log_file.write_all(text.as_bytes())), "writing to the run log");

fn string log_header_text(Job target_job)
	(name, folder, command) in target_job

	int now_time = n_now()
	string stamp = time_format(now_time)
	string newline = "\n"
	string prefixed = "\n$ "
	string shown = s_replace(command, newline, prefixed)

	return s_join(["[", stamp, "] Starting \"", name, "\" in ", folder, "\n$ ", shown, "\n\n"])

fn string log_footer_text(Run finished)
	(status, note, finished_at) in finished

	string stamp = time_format(finished_at)
	string message = note

	if status is "ok"
		message = "Finished OK"

	return s_join(["\n[", stamp, "] ", message, "\n"])

fn void execute_job(Database store, Job target_job, string trigger)
	(folder, command) in target_job

	string status = "running"
	Run record = run_record(target_job, trigger, status)
	int run_id = db_insert_run(store, record)
	Run started = record with (run_id)

	string log_path = log_file_path(run_id)
	string header = log_header_text(target_job)
	append_log(log_path, header)
	int exit_code = run_command(folder, command, log_path)

	Run finished = finished_run(started, exit_code)
	string footer = log_footer_text(finished)
	append_log(log_path, footer)
	db_finish_run(store, finished)

fn string expand_home(string path)
	string tilde = "~"
	bool has_tilde = s_starts_with(path, tilde)

	if has_tilde
		string home = home_directory()
		int start = 1
		int stop = len(path)
		string rest = s_substring(path, start, stop)

		return s_join([home, rest])

	return path
