import "app/imports.deor"

rust
	pub const APP_NAME: &str = "Job Runner";

	#[path = "../rust/tray.rs"]
	mod tray;
	#[path = "../rust/ui.rs"]
	mod ui;

# Starts the background service by default; 'ui' opens only the window (the tray icon launches it).
fn void main()
	(first) in args()

	if first is "ui"
		ui_run()
	else if first is "daemon" or first is ""
		daemon_run()
	else
		crash("Unknown command. Use 'daemon' (default) or 'ui'.")
