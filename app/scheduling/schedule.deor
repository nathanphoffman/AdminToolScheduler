# Pure scheduling rules: when a job is next due, when a run counts as missed, how to word a schedule.

# A job's schedule entry: when it is next due, counted from now_time, remembered with the edit it belongs to.
fn DueEntry fresh_entry(Job target_job, int now_time)
	unsafe_macro_run use_schedule_values

	(job_id, updated_at, sched_kind, sched_value) in target_job

	int minutes = sched_value

	if minutes < 1
		minutes = 1

	int due_time = now_time + minutes * SECONDS_PER_MINUTE

	if sched_kind is SCHEDULE_DAILY
		due_time = time_next_daily(sched_value, now_time)

	int entry_job = job_id
	int entry_updated = updated_at
	DueEntry fresh = (entry_job, entry_updated, due_time)

	return fresh

# A run this many seconds past its due time means the computer was asleep or off, so it is skipped.
fn bool schedule_is_late(int now_time, int due_time)
	const int LATE_LIMIT_SECONDS = 90
	int late = now_time - due_time

	return late > LATE_LIMIT_SECONDS

# The schedule in words, like 'Daily at 02:00' or 'Every 2 hours'.
fn string schedule_text(Job target_job)
	unsafe_macro_run use_schedule_values

	(sched_kind, sched_value) in target_job

	if sched_kind is SCHEDULE_DAILY
		string clock = clock_text(sched_value)

		return s_join(["Daily at ", clock])

	int hours = sched_value / MINUTES_PER_HOUR
	int leftover = sched_value % MINUTES_PER_HOUR

	if leftover is 0 and hours is 1
		return "Every hour"

	if leftover is 0
		string hour_count = c_int_to_string(hours)

		return s_join(["Every ", hour_count, " hours"])

	string minute_count = c_int_to_string(sched_value)

	return s_join(["Every ", minute_count, " min"])

fn Job blank_job()
	unsafe_macro_run use_schedule_values

	int job_id = 0
	string name = ""
	string folder = "~"
	string command = ""
	string sched_kind = SCHEDULE_INTERVAL
	int sched_value = DEFAULT_INTERVAL_MINUTES
	bool enabled = false
	int updated_at = 0
	Job blank = (job_id, name, folder, command, sched_kind, sched_value, enabled, updated_at)

	return blank
