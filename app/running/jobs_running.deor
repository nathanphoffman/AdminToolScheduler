# Which jobs are running right now, running them on their own threads, and keeping to one service.

rust
	static RUNNING_JOBS: std::sync::Mutex<Vec<i64>> = std::sync::Mutex::new(Vec::new());
	static JOB_SENDER: std::sync::OnceLock<std::sync::Mutex<std::sync::mpsc::Sender<(Job, String)>>> = std::sync::OnceLock::new();
	static INSTANCE_LOCK: std::sync::OnceLock<std::fs::File> = std::sync::OnceLock::new();

# Claims the right to run a job; false when that job is already running.
fn bool running_claim(int job_id)
	rust
		let mut running = RUNNING_JOBS.lock().unwrap();
		if running.contains(&job_id) {
			false
		} else {
			running.push(job_id);
			true
		}

fn void running_release(int job_id)
	rust
		RUNNING_JOBS.lock().unwrap().retain(|running_id| *running_id != job_id);

fn int running_count()
	rust
		RUNNING_JOBS.lock().unwrap().len() as i64

# Hands a started job to the dispatcher. If that is impossible, its running slot is freed again.
fn void enqueue_job(Job target_job, string trigger)
	rust
		let job_id = target_job.job_id;
		let sent = match JOB_SENDER.get() {
			Some(sender) => sender.lock().unwrap().send((target_job, trigger)).is_ok(),
			None => false,
		};

		if !sent {
			eprintln!("job runner: could not queue a job; the dispatcher is not running");
			RUNNING_JOBS.lock().unwrap().retain(|running_id| *running_id != job_id);
		}

# Starts the dispatcher: it waits for queued jobs and runs each on its own thread with its own database connection.
fn void start_dispatcher()
	rust
		let (sender, receiver) = std::sync::mpsc::channel::<(Job, String)>();
		JOB_SENDER.set(std::sync::Mutex::new(sender)).expect("the dispatcher was started twice");

		// One thread waits for jobs; each job it receives gets a thread of its own so jobs never wait on each other.
		std::thread::spawn(move || {
			for (target_job, trigger) in receiver {
				std::thread::spawn(move || {
					let job_id = target_job.job_id;
					let store = db_open();
					execute_job(store, target_job, trigger);
					running_release(job_id);
				});
			}
		});

# Only one background service may run at a time; the lock is held until the process exits.
fn bool instance_lock_acquire()
	rust
		let lock_file = std::fs::OpenOptions::new().create(true).write(true).truncate(false).open(data_dir().join("daemon.lock")).expect("could not open the lock file");

		match lock_file.try_lock() {
			Ok(()) => {}
			Err(std::fs::TryLockError::WouldBlock) => return false,
			Err(std::fs::TryLockError::Error(error)) => panic!("could not lock the lock file: {error}"),
		}
		INSTANCE_LOCK.set(lock_file).expect("the instance lock was already held");
		true
