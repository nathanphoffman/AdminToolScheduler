# The jobs table: list, save, delete, and the three default jobs created on first start.

fn jobList db_list_jobs(Database store)
	rust
		let conn = store.0.lock().unwrap();
		// An immediately-run closure, so `?` can stop at the first database error and hand it back as one Result.
		let rows: rusqlite::Result<Vec<Job>> = (|| {
			let mut statement = conn.prepare("SELECT id, name, cwd, command, sched_kind, sched_value, enabled, updated_at FROM jobs ORDER BY id")?;
			let mapped = statement.query_map([], |table_row| job_from_row(table_row))?;
			let collected: rusqlite::Result<Vec<Job>> = mapped.collect();
			collected
		})();
		report(rows)

fn void db_insert_job(Database store, Job target_job)
	rust
		let conn = store.0.lock().unwrap();
		let now_time = n_now();
		report(conn.execute("INSERT INTO jobs (name, cwd, command, sched_kind, sched_value, enabled, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?)", params![target_job.name, target_job.folder, target_job.command, target_job.sched_kind, target_job.sched_value, target_job.enabled as i64, now_time]));

fn void db_update_job(Database store, Job target_job)
	rust
		let conn = store.0.lock().unwrap();
		let now_time = n_now();
		report(conn.execute("UPDATE jobs SET name = ?, cwd = ?, command = ?, sched_kind = ?, sched_value = ?, enabled = ?, updated_at = ? WHERE id = ?", params![target_job.name, target_job.folder, target_job.command, target_job.sched_kind, target_job.sched_value, target_job.enabled as i64, now_time, target_job.job_id]));

# A job with job_id 0 has never been saved, so it is a new row; anything else updates its row.
fn void db_save_job(Database store, Job target_job)
	(job_id) in target_job

	if job_id is 0
		db_insert_job(store, target_job)
	else
		db_update_job(store, target_job)

fn void db_delete_job(Database store, int job_id)
	rust
		let conn = store.0.lock().unwrap();
		report(conn.execute("DELETE FROM jobs WHERE id = ?", params![job_id]));
