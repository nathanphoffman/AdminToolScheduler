# Starting commands and tracking which jobs are running right now.
# run_command returns the command's exit code, -1 if a signal stopped it, -2 if it could not start.

rust
	static RUNNING_JOBS: std::sync::Mutex<Vec<i64>> = std::sync::Mutex::new(Vec::new());
	static INSTANCE_LOCK: std::sync::OnceLock<std::fs::File> = std::sync::OnceLock::new();

fn string home_directory()
	rust
		dirs::home_dir().map(|home| home.display().to_string()).unwrap_or_default()

# Stdout and stderr are folded together (exec 2>&1) so the log keeps the real order of messages.
# `set -e` stops a multi-line job at the first line that fails.
fn int run_command(string folder, string command, string log_path)
	rust
		use std::io::{Read, Write};
		use std::process::{Command, Stdio};
		let mut log = std::fs::OpenOptions::new().append(true).create(true).open(&log_path).expect("could not open the run log");
		let script = format!("exec 2>&1\nset -e\n{}\n", command);
		let spawned = Command::new("bash").arg("-c").arg(&script).current_dir(&folder).stdin(Stdio::null()).stdout(Stdio::piped()).spawn();
		let mut child = match spawned {
			Ok(child) => child,
			Err(error) => {
				let _ = writeln!(log, "Could not start the job: {error} (folder: {folder})");
				return -2;
			}
		};
		let mut output = child.stdout.take().unwrap();
		let mut buffer = [0u8; 4096];
		loop {
			match output.read(&mut buffer) {
				Ok(0) | Err(_) => break,
				Ok(count) => {
					let _ = log.write_all(&buffer[..count]);
					let _ = log.flush();
				}
			}
		}
		match child.wait() {
			Ok(status) => status.code().map(|code| code as i64).unwrap_or(-1),
			Err(_) => -1,
		}

# Claims the right to run a job; false when that job is already running.
fn bool running_claim(int job_id)
	rust
		let mut running = RUNNING_JOBS.lock().unwrap();
		if running.contains(&job_id) {
			false
		} else {
			running.push(job_id);
			true
		}

fn void running_release(int job_id)
	rust
		RUNNING_JOBS.lock().unwrap().retain(|id| *id != job_id);

fn int running_count()
	rust
		RUNNING_JOBS.lock().unwrap().len() as i64

# Runs the job on its own thread with its own database connection, then frees its running slot.
fn void spawn_job_thread(Job job, string trigger)
	rust
		std::thread::spawn(move || {
			let job_id = job.job_id;
			let store = db_open();
			execute_job(store, job, trigger);
			running_release(job_id);
		});

# Only one background service may run at a time; the lock is held until the process exits.
fn bool instance_lock_acquire()
	rust
		let file = std::fs::OpenOptions::new().create(true).write(true).truncate(false).open(data_dir().join("daemon.lock")).expect("could not open the lock file");
		if file.try_lock().is_err() {
			return false;
		}
		let _ = INSTANCE_LOCK.set(file);
		true
