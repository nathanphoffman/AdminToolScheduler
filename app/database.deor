# SQLite storage. Deor owns the shape of the data; the rust blocks only talk to the rusqlite crate.
# A Database is a shared handle, so every thread opens its own with db_open().

raw Database

rust
	use rusqlite::{params, Connection};

	#[derive(Clone)]
	pub struct Database(pub std::sync::Arc<std::sync::Mutex<Connection>>);

	pub fn data_dir() -> std::path::PathBuf {
		let dir = dirs::data_dir().unwrap_or_else(|| std::path::PathBuf::from(".")).join("jobrunner");
		let _ = std::fs::create_dir_all(dir.join("logs"));
		dir
	}

	// Database errors are printed, never hidden; the caller gets an empty default so the loop keeps going.
	fn report<T: Default>(result: rusqlite::Result<T>) -> T {
		match result {
			Ok(value) => value,
			Err(error) => {
				eprintln!("database error: {error}");
				T::default()
			}
		}
	}

	fn job_from_row(row: &rusqlite::Row) -> rusqlite::Result<Job> {
		Ok(Job {
			job_id: row.get(0)?,
			name: row.get(1)?,
			cwd: row.get(2)?,
			command: row.get(3)?,
			sched_kind: row.get(4)?,
			sched_value: row.get(5)?,
			enabled: row.get::<_, i64>(6)? != 0,
			updated_at: row.get(7)?,
		})
	}

	fn run_from_row(row: &rusqlite::Row) -> rusqlite::Result<Run> {
		Ok(Run {
			run_id: row.get(0)?,
			job_id: row.get(1)?,
			job_name: row.get(2)?,
			started_at: row.get(3)?,
			finished_at: row.get::<_, Option<i64>>(4)?.unwrap_or(0),
			status: row.get(5)?,
			exit_code: row.get::<_, Option<i64>>(6)?.unwrap_or(-1),
			trigger_kind: row.get(7)?,
			note: row.get::<_, Option<String>>(8)?.unwrap_or_default(),
		})
	}

fn Database db_open()
	rust
		let conn = Connection::open(data_dir().join("jobrunner.db")).expect("could not open the job database");
		conn.busy_timeout(std::time::Duration::from_secs(5)).ok();
		conn.execute_batch(concat!(
			"PRAGMA journal_mode = WAL;",
			"CREATE TABLE IF NOT EXISTS jobs (id INTEGER PRIMARY KEY, name TEXT NOT NULL, cwd TEXT NOT NULL, command TEXT NOT NULL, sched_kind TEXT NOT NULL, sched_value INTEGER NOT NULL, enabled INTEGER NOT NULL DEFAULT 1, updated_at INTEGER NOT NULL DEFAULT 0);",
			"CREATE TABLE IF NOT EXISTS runs (id INTEGER PRIMARY KEY, job_id INTEGER NOT NULL, job_name TEXT NOT NULL, started_at INTEGER NOT NULL, finished_at INTEGER, status TEXT NOT NULL, exit_code INTEGER, trigger_kind TEXT NOT NULL, note TEXT);",
			"CREATE TABLE IF NOT EXISTS run_requests (id INTEGER PRIMARY KEY, job_id INTEGER NOT NULL);",
			"CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value INTEGER NOT NULL);"
		)).expect("could not create the job tables");
		Database(std::sync::Arc::new(std::sync::Mutex::new(conn)))

fn string log_file_path(int run_id)
	rust
		data_dir().join("logs").join(format!("{run_id}.log")).to_string_lossy().into_owned()
