# What the daemon tells the outside world: a heartbeat and next-run times for the window, and the tray icon.

fn void publish_next_run(Database store, DueEntry entry)
	(entry_job, due_time) in entry

	string id_text = c_int_to_string(entry_job)
	string meta_key = s_join(["next_", id_text])
	db_set_meta(store, meta_key, due_time)

fn bool last_run_failed(Database store)
	unsafe_macro_run use_run_words

	string status = db_last_status(store)
	bool failed = status is RUN_FAILED

	return failed

# The tray dot is green while anything runs, red if the newest finished run failed, otherwise blue.
fn string tray_status_word()
	unsafe_macro_run use_tray_words

	int running = running_count()

	if running > 0
		return TRAY_RUNNING

	return TRAY_IDLE

# Writes what the window and tray need: a heartbeat, each job's next run, and the tray colour.
fn void publish_status(Database store, dueList entries)
	unsafe_macro_run use_tray_words

	string heartbeat_key = "heartbeat"
	int now_time = n_now()
	db_set_meta(store, heartbeat_key, now_time)

	for entry in entries
		publish_next_run(store, entry)

	string word = tray_status_word()
	bool failed = last_run_failed(store)

	if word is TRAY_IDLE and failed
		word = TRAY_FAILED

	tray_update(word)

fn void tray_start()
	rust
		tray::start();

fn void tray_update(string status_word)
	rust
		tray::update(&status_word);
