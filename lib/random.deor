# DO NOT EDIT THIS FILE — it ships with the Deor standard library and is
# overwritten by `deor update`. Local changes will be silently lost.
#
# To add your own functions to this module, create lib/random_extension.deor
# instead and import it alongside this file.

rust
	thread_local! {
		static RNG_STATE: std::cell::Cell<u64> = std::cell::Cell::new({
			std::time::SystemTime::now()
				.duration_since(std::time::UNIX_EPOCH)
				.map(|d| d.as_nanos() as u64)
				.unwrap_or(12345)
		});
	}
	fn _rng_next() -> u64 {
		RNG_STATE.with(|s| {
			let mut x = s.get();
			// xorshift64: three shift-and-xor steps scramble the bits into the next random number.
			x ^= x << 13; // shift left 13 and mix back in with xor
			x ^= x >> 7; // shift right 7 and mix back in
			x ^= x << 17; // shift left 17 and mix back in
			s.set(x);
			x
		})
	}

fn int m_rand_int(int min, int max)
	rust
		let lo = min as i64;
		let hi = max as i64;
		(lo + (_rng_next() % ((hi - lo + 1) as u64)) as i64) as i64

fn float m_rand_float()
	rust
		(_rng_next() as f64) / (u64::MAX as f64)

fn bool m_rand_bool()
	rust
		_rng_next() % 2 == 0
